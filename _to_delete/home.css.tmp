
/* Home (src/components/Home.tsx): the front page, the site's own dark palette with the gold accent, orbiter art for imagery */
.home { max-width: 1200px; margin: 0 auto; display: grid; gap: 40px; padding-bottom: 48px; }
.home-hero { display: flex; flex-wrap: wrap; align-items: center; gap: 32px 48px; padding: 40px 32px; border-radius: 14px; border: 1px solid var(--border);
  background: radial-gradient(120% 140% at 85% 50%, rgba(212, 180, 106, 0.16), transparent 60%), var(--panel); overflow: hidden; }
.home-hero-text { flex: 1 1 420px; display: grid; gap: 16px; max-width: 560px; }
.home-eyebrow { margin: 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
.home-title { margin: 0; font-size: clamp(2rem, 4.2vw, 3.2rem); line-height: 1.08; font-weight: 700; letter-spacing: -0.01em; }
.home-lede { margin: 0; font-size: 1.05rem; line-height: 1.6; color: #b4bac6; }
.home-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
.home-actions button { min-height: 46px; padding: 0 20px; font-weight: 600; cursor: pointer; }
.home-actions button:hover { border-color: var(--accent); }
.home .home-primary { background: var(--accent); color: #15130d; border-color: var(--accent); }
.home .home-primary:hover { background: #e2c684; }
/* three posters fanned out like they're leaning on the orbiter wall */
.home-fan { flex: 1 1 360px; position: relative; height: 340px; min-width: 280px; }
.home-fan-art { position: absolute; top: 50%; left: 50%; width: 190px; height: 300px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(212, 180, 106, 0.45);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55); background: #0b0c10; }
.home-fan-0 { transform: translate(-125%, -50%) rotate(-8deg); }
.home-fan-1 { transform: translate(-50%, -54%); z-index: 1; width: 210px; height: 320px; }
.home-fan-2 { transform: translate(25%, -50%) rotate(8deg); }

.home-section { display: grid; gap: 16px; }
.home-section h2 { margin: 0; font-size: 1.3rem; }
.home .home-link { background: none; border: 0; color: var(--accent); padding: 8px 0; cursor: pointer; font-weight: 600; }
.home-records { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
.home .home-record { display: grid; gap: 6px; justify-items: start; text-align: left; padding: 18px; border-radius: 12px; background: var(--panel); border: 1px solid var(--border); cursor: pointer; }
.home .home-record:hover { border-color: var(--accent); }
.home-record-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.home-record-art { width: 100%; height: 72px; object-fit: contain; margin: 4px 0; }
.home-record-value { font-size: 1.8rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
.home-record-name { font-weight: 600; }
.home-record-attack { font-size: 0.8rem; color: var(--muted); }
.home-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
.home .home-tool { display: grid; gap: 6px; text-align: left; padding: 18px; border-radius: 12px; background: var(--panel); border: 1px solid var(--border); cursor: pointer; }
.home .home-tool:hover { border-color: var(--accent); }
.home-tool-title { font-weight: 700; font-size: 1.02rem; }
.home-tool-blurb { font-size: 0.88rem; line-height: 1.45; color: #b4bac6; }
/* the orbiter wall: a scrolling row of decorations */
.home-wall { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x mandatory; }
.home-wall-item { margin: 0; flex: 0 0 168px; display: grid; gap: 8px; scroll-snap-align: start; }
.home-wall-art { width: 168px; height: 250px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); background: #0b0c10; }
.home-wall-item figcaption { font-size: 0.8rem; color: var(--muted); }
@media (max-width: 640px) {
  .home-hero { padding: 28px 18px; }
  .home-fan { height: 280px; }
  .home-fan-art { width: 150px; height: 240px; }
  .home-fan-1 { width: 165px; height: 255px; }
}
